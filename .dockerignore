# Keep secrets, local state and build output out of the image's build context.
# The image builds its own CSS and static files (see Dockerfile).

# Secrets (at any depth, as in .gitignore; "**/" also matches the root) and
# version control
**/.env
**/.env.*
.git

# Local Python environment and caches
.venv
**/__pycache__
.ruff_cache

# Local databases (the container keeps its own on the data volume)
**/*.sqlite3*

# Build output: the image downloads the Linux Tailwind binary and builds these
src/assets/css/tailwind.css
src/.django_tailwind_cli
src/staticfiles

# Workflow artifacts and tooling, not needed to run the app
work
.claude
.idea
.DS_Store
