# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Variables already set in the process environment take precedence over .env.
# Format: one NAME=value per line, with no spaces around "=". Lines that don't
# parse are logged as warnings, value included.

# Required. Django's cryptographic signing key; startup fails if it is unset or empty.
# Generate one with:
#   ./.venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True/False. Defaults to False when unset.
# LOCAL DEVELOPMENT ONLY: never deploy with DEBUG=True; it exposes stack traces and settings.
DEBUG=True

# Comma-separated host names this site may serve. Defaults to localhost,127.0.0.1 when unset;
# set but empty means no host is allowed (every request is rejected when DEBUG is off).
ALLOWED_HOSTS=localhost,127.0.0.1

# Required. OpenAI API key for the AI features; startup fails if it is unset or empty.
# sk-dummy is enough for the test suite and the dev server (tests never call the API);
# put a real key here only in your own .env, never in a committed file.
OPENAI_API_KEY=sk-dummy

# Chat Completions model for the AI features. Defaults to gpt-4.1-mini when unset or empty.
OPENAI_MODEL=gpt-4.1-mini
