# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Variables already set in the process environment take precedence over .env.

# Required. Django's cryptographic signing key; startup fails if it is unset or empty.
# Generate one with:
#   ./.venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True/False. Defaults to False when unset; keep True only for local development.
DEBUG=True

# Comma-separated host names this site may serve. Defaults to localhost,127.0.0.1.
ALLOWED_HOSTS=localhost,127.0.0.1
